<?xml version="1.0" encoding="utf-8"?>
<!--
  Trust the system CAs plus a few public roots that older Android devices lack, so the "SMS server"
  (and webhook) TLS connections work on Android 8/9 phones often used as gateways (e.g. Galaxy S7).
  Without these, such devices reject valid servers with "Trust anchor for certification path not found".
    - GlobalSign Root CA - R6: added to Android only in 10 (e.g. sms.ismarty.pro chains to it).
    - ISRG Root X1 / X2: Let's Encrypt roots, missing on Android < 7.1.1 — the most common case for
      self-hosted servers.
  All fingerprints are verified against the published SHA-256 before bundling.

  cleartextTrafficPermitted stays true: the app runs a local HTTP server and talks http:// on the LAN.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/globalsign_r6" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
